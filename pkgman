#!/usr/bin/env bash

# pkgman - Run commands by name
# Usage: pkgman <name>
# Edit the COMMANDS section below to add your own mappings

# ─── COMMANDS ─────────────────────────────────────────────────────────────────
declare -A COMMANDS=(
    ["appimageupdatetool"]="appimageupdatetool --self-update"
    ["brave"]="appimageupdatetool --overwrite ~/Applications/AppImages/brave"
    ["keepassxc"]="appimageupdatetool --overwrite ~/Applications/AppImages/keepassxc"
    ["nvim"]="appimageupdatetool --overwrite ~/Applications/AppImages/nvim"
    ["wezterm"]="appimageupdatetool --overwrite ~/Applications/AppImages/wezterm"
    ["vscode"]="appimageupdatetool --overwrite ~/Applications/AppImages/vscode"
)
# ──────────────────────────────────────────────────────────────────────────────

usage() {
    echo "Usage: pkgman <name>"
    echo ""
    echo "Available names:"
    for name in "${!COMMANDS[@]}"; do
        printf "  %-15s %s\n" "$name" "${COMMANDS[$name]}"
    done | sort
}

if [[ $# -eq 0 || "$1" == "--help" || "$1" == "-h" ]]; then
    usage
    exit 0
fi

NAME="$1"

if [[ -z "${COMMANDS[$NAME]+_}" ]]; then
    echo "pkgman: unknown name '$NAME'"
    echo "Run 'pkgman' with no arguments to see available names."
    exit 1
fi

CMD="${COMMANDS[$NAME]}"
echo "► $CMD"
eval "$CMD"
